{
  "name": "travel-desk",
  "version": "1.0.0",
  "description": "TravelDesk — employee travel request & approval app (CAP + TypeScript + Fiori Elements)",
  "engines": {
    "node": "^20 || ^22"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "build": "cds build --production"
  },
  "dependencies": {
    "@sap/cds": "^10.1.1",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/sqlite": "^3.1.1",
    "ts-node": "^10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "auth": {
         "kind": "mocked",
          "users": {
            "manager": { "password": "manager123", "roles": ["Manager", "Employee"] },
            "employee": { "password": "employee123", "roles": ["Employee"] }
          }
      },
      "messaging": {
      "kind": "local-messaging"
      },
      "[production]": {
        "db": "hana",
        "auth": "xsuaa",
        "messaging": {
          "kind": "enterprise-messaging-shared",
          "publishPrefix": "$namespace/",
          "format": "cloudevents"
        }
      }
    },
    "features": {
      "typescript": true
    }
  }
}
