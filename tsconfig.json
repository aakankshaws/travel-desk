{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "gen",
    "types": ["node"]
  },
  "include": ["srv/**/*.ts", "@cds-models/**/*.ts"],
  "exclude": ["node_modules", "gen"]
}
